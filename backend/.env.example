# Application environment (development or production)
ENV=development

# API route prefix (default: /api/v1)
API_PREFIX=/api/v1

# MongoDB Atlas connection URI with credentials and cluster address
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB database name
MONGODB_DB=yojanasetu

# Groq API key for LLM inference (profile extraction and explanations)
GROQ_API_KEY=gsk_placeholder_groq_api_key

# Groq model identifier (e.g., llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Hosted embeddings provider name (e.g., hosted, voyage, cohere)
EMBEDDING_PROVIDER=hosted

# API key for the hosted embeddings service
EMBEDDING_API_KEY=placeholder_embedding_api_key

# Model identifier for hosted multilingual embeddings
EMBEDDING_MODEL=hosted-multilingual-e5

# Output vector dimensionality for scheme chunk embeddings
EMBEDDING_DIM=384

# Secret key for signing admin JWT access tokens (minimum 32 characters in production)
JWT_SECRET=temporary_development_jwt_secret_key_min_32_characters_long

# JWT token issuer identifier
JWT_ISSUER=yojanasetu

# JWT access token expiration duration in minutes
ACCESS_TOKEN_MINUTES=60

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Whether OpenAPI /docs and /redoc interactive endpoints are enabled (false in production)
ENABLE_DOCS=true

# General per-IP request rate limit per minute
RATE_LIMIT_PER_MINUTE=60

# Maximum daily LLM inference calls allowed across the application
LLM_DAILY_CALL_CAP=1000

# Minimum cosine similarity threshold for vector search relevance
SIMILARITY_THRESHOLD=0.7

# Application logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

